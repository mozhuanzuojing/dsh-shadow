{
  "name": "dsh-shadow",
  "version": "1.15.39",
  "description": "agent 思维/上下文/灵魂的投影——每条记忆一个文件，记录「完整线索链」（背景/材料 + 用户提示/决策 + 概况）；read_shadow 分层召回 + 记忆遗忘(retention) + 护栏(数据非指令)；shadow_query 另有 resource 类型（`.shadow/resources/` 资源卡的派生投影）。TypeScript 源码 index.ts → tsc → dist/index.js（DSH 加载编译后 JS）。验证基线 DSH 0.1.5-rc.1（engines.dsh，是验证基线声明而非强制闸门；挂载时靠能力探测报告缺件）。",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "agent-presets",
    "docs",
    "tools",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc -w",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "verify": "npm run typecheck:tools && npx tsc --noEmit && npm run test:all",
    "test:all": "npm run build && node tools/run-tests.ts",
    "verify:toolset": "node tools/winget-verify.ts",
    "verify:seed": "node tools/winget-verify-seed.ts",
    "eval:retrieval": "node tools/retrieval-eval.ts",
    "audit:wiring": "node tools/audit-wiring.ts .",
    "audit:wiring:selftest": "node tools/audit-wiring.selftest.ts",
    "audit:drift": "node tools/audit-drift.ts .",
    "audit:drift:selftest": "node tools/audit-drift.selftest.ts",
    "verify:authority": "node tools/toolset-authority.ts",
    "verify:authority:check": "node tools/toolset-authority.ts --check"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "agent-memory",
    "memory-tree",
    "plugin"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.5-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^7.0.2"
  }
}
